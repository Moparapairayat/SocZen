# ==============================================================================
# SocZen Environment Configuration
# ==============================================================================

# Database (Neon Serverless PostgreSQL or Local Postgres)
# Neon example: postgresql://[user]:[password]@[neon-hostname]/neondb?sslmode=require
# Local example: postgresql://postgres:postgres@localhost:5433/soczen
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/soczen
DATABASE_SSL=disable

# Admin Panel Security
ADMIN_PASSWORD=change-me-to-a-secure-password

# Google Gemini AI (Vercel AI SDK - For Automated Request Triage & Scoring)
# Get a key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Upstash Redis (For Distributed Rate Limiting & Anti-Abuse)
# Get credentials at: https://console.upstash.com/
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Resend Email Delivery (Optional)
# Get credentials at: https://resend.com/
RESEND_API_KEY=
RESEND_FROM_EMAIL=SocZen <access@yourdomain.com>
RESEND_ADMIN_EMAIL=admin@yourdomain.com
RESEND_REPLY_TO=access@yourdomain.com
